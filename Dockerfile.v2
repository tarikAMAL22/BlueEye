FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.10 + system deps
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    libglib2.0-0 libsm6 libxext6 libgl1 \
    cmake build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# Core packages
RUN pip install --no-cache-dir --default-timeout=1000 \
    opencv-python-headless mysql-connector-python pymysql \
    cryptography DBUtils requests numpy Pillow flask \
    scipy redis

# face_recognition (dlib — large compile step)
RUN pip install --no-cache-dir --default-timeout=1000 face_recognition

# PyTorch with CUDA 12.1 (RTX 3060 = compute 8.6, fully supported)
RUN pip install --no-cache-dir --default-timeout=1000 \
    torch torchvision --index-url https://download.pytorch.org/whl/cu121

# YOLOv8
RUN pip install --no-cache-dir --default-timeout=1000 ultralytics

# RetinaFace
RUN pip install --no-cache-dir --default-timeout=1000 retina-face tf-keras

COPY cv_worker_v2/ ./cv_worker_v2/

CMD ["python", "-m", "cv_worker_v2.main"]
