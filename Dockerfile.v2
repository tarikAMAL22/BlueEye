FROM python:3.10-slim

WORKDIR /app

# Use the exact same system dependencies as the original working Dockerfile
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libgl1 \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install core python packages
RUN pip install --no-cache-dir --default-timeout=1000 opencv-python-headless mysql-connector-python pymysql cryptography DBUtils requests numpy Pillow flask

# Install face_recognition separately (large models)
RUN pip install --no-cache-dir --default-timeout=1000 face_recognition

# Install PyTorch CPU-only first (150MB instead of 530MB CUDA version)
RUN pip install --no-cache-dir --default-timeout=1000 torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install Ultralytics (YOLOv8) — torch already satisfied above
RUN pip install --no-cache-dir --default-timeout=1000 ultralytics

# Install RetinaFace
RUN pip install --no-cache-dir --default-timeout=1000 retina-face tf-keras

# Install MediaPipe — primary face detector (replaces Haar for tilt/partial face detection)
# Pin to 0.10.9 (last version with mp.solutions API) + matching protobuf range
# protobuf>=4.21 required for runtime_version; <5 to avoid API breaks from other deps
RUN pip install --no-cache-dir --default-timeout=1000 "protobuf>=4.21.0,<5.0.0" "mediapipe==0.10.9"

# Copy the entire modular package
COPY cv_worker_v2/ ./cv_worker_v2/

# Run as a module
CMD ["python", "-m", "cv_worker_v2.main"]
