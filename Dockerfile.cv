FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir opencv-python-headless mysql-connector-python \
    requests face_recognition numpy Pillow flask scipy redis

# YOLOv8 face detector (optional — enabled via USE_YOLO_DETECTOR=true)
RUN pip install --no-cache-dir ultralytics

COPY cv_worker.py .

CMD ["python", "cv_worker.py"]
